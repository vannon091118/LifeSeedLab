{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // `allowJs`: die Tooling-Tests importieren die echte Lane (`scripts/test-lane-verdict.mjs`).
    // Ohne das meldete `tsc -p tools` TS7016 („keine Deklaration“) für einen Pfad, der zur
    // Laufzeit längst grün war. Kein `checkJs` — die Datei wird nur aufgelöst, nicht bewertet.
    "allowJs": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "types": []
  },
  "include": ["shinon/**/*.ts", "types/**/*.d.ts"]
}
