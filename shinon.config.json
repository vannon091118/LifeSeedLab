{
  "gate": {
    "enforcement": "strict",
    "checks": {
      "e2e": false,
      "changelog": true,
      "docLinks": true
    },
    "commands": {
      "typecheck": {
        "command": "node",
        "args": ["node_modules/typescript/bin/tsc", "-b", "--noEmit"],
        "enabled": true
      },
      "tests": {
        "command": "node",
        "args": ["scripts/test-lane.mjs"],
        "enabled": true
      },
      "changelog": {
        "command": "bash",
        "args": ["./scripts/check-changelog.sh"],
        "enabled": true
      }
    }
  }
}