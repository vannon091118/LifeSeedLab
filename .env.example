# LifeSeedLab — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local (already in .gitignore)

# Browser Use Cloud (EU deployment)
# Get key at: https://cloud.eu.browser-use.com/settings?tab=api-keys&new=1
BROWSER_USE_API_KEY=bu_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Supabase for discovery chain mirror
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Analytics / Error tracking
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx