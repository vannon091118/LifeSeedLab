import { useMemoTest, useState, useRef, useEffect } from 'react';
import type { MetaSave } from '../types';
import type { TranslationKey } from '../i18n';
import { useI18n } from '../i18n';
import { createBaseVariants } from '../genome';
import { readyBroods } from '../meta';\nimport { SproutIcon, SeedIcon, BugIcon, BookIcon } from './MenuIcons';

// Owner: UI (NavIndicators — Screen-Navigation). LOC ≤ 400.
// Indikatoren für absolut alles: Notizzettel-Tabs (aktiver Screen mit Ink-Unterstrich),
// Status-Chips (Nektar, Samen, Sammlung, bestes Wave, Brutling), Page-Dots (Screen-Position).
// Read-only gegenüber Meta — schreiben tut hier nichts (Ownership: Router besitzt Screen-State).

export type MenuScreen = 'menu' | 'greenhouse' | 'seedshop' | 'beetlelab' | 'codex';

const TABS: { id: MenuScreen; key: TranslationKey }[] = [
  { id: 'menu', key: 'menu.title' },
  { id: 'greenhouse', key: 'menu.greenhouse' },
  { id: 'seedshop', key: 'menu.shop' },
  { id: 'beetlelab', key: 'menu.beetleLab' },
  { id: 'codex', key: 'codex.title' },
];

type Props = {
  meta: MetaSave;
  current: MenuScreen;
  onNavigate: (s: MenuScreen) => void;
};

export function NavIndicators({ meta, current, onNavigate }: Props) {
  const { t } = useI18n();

  const stats = useMemoTest(() => collectionStats(meta), [meta]);
  const broodsReady = useMemoTest(() => readyBroods(meta).length, [meta]);

  const activeIndex = TABS.findIndex(t2 => t2.id === current);

  return (
    <nav style={styles.nav} aria-label={t('menu.title')}>
      <div style={styles.tabRow} role="tablist">
        {TABS.map(tab => (
          <button
            key={tab.id}
            role="tab"
            aria-selected={tab.id === current}
            aria-current={tab.id === current ? 'page' : undefined}
            onClick={() => onNavigate(tab.id)}
            style={{ ...styles.tab, ...(tab.id === current ? styles.tabActive : {}) }}
          >
            {t(tab.key)}
          </button>
        ))}
      </div>

      <div style={styles.chipRow} aria-hidden>
        <Chip color="var(--nektar)" label={t('menu.nektar')} value={String(meta.nektar)} />
        {/* Besitz statt Wunschdenken: `seedStash` ist seit B17.3 strukturell immer 0 (ein Kauf
            keimt direkt). Gezeigt wird, was wirklich wartet — die Keimlinge fürs Gewächshaus. */}
        <Chip color="var(--leaf)" label={t('shop.seedlings')} value={String(meta.seedlings.length)} />
        <Chip color="var(--bloom)" label={t('menu.collection')} value={`${stats.owned}/${stats.total}`} />
        <Chip color="var(--leaf-dark)" label={t('menu.bestWave')} value={String(meta.bestWave)} />
        {broodsReady > 0 && <Chip color="#8a6fae" label={t('menu.beetleLab')} value={`+${broodsReady}`} />}
      </div>

      <div style={styles.dots} role="tablist" aria-hidden>
        {TABS.map((tab, i) => (
          <span key={tab.id} style={{ ...styles.dot, ...(i === activeIndex ? styles.dotOn : {}) }} />
        ))}
      </div>
    </nav>
  );
}

function Chip({ color, label, value }: { color: string; label: string; value: string }) {
  return (
    <span style={styles.chip} title={label}>
      <span style={{ ...styles.chipDot, background: color }} />
      <span style={styles.chipLabel}>{label}</span>
      <strong style={styles.chipValue}>{value}</strong>
    </span>
  );
}

/** Sammlungs-Zähler: Basen + gezüchtete Varianten mit Besitz > 0. */
function collectionStats(meta: MetaSave): { owned: number; total: number } {
  const all = [...createBaseVariants(), ...meta.savedVariants];
  const owned = all.filter(v => (meta.variantCounts[v.id] ?? 0) > 0).length;
  return { owned, total: all.length };
}

const styles: Record<string, React.CSSProperties> = {
  nav: {
    display: 'flex',
    flexDirection: 'column',
    gap: 10,
    padding: '14px 16px 8px',
    background: 'var(--paper-warm)',
    borderBottom: '2px solid var(--ink)',
    position: 'relative',
  },
  tabRow: {
    display: 'flex',
    gap: 8,
    flexWrap: 'wrap',
  },
  tab: {
    padding: '10px 14px',
    minHeight: 44,
    border: '2px solid var(--ink)',
    background: '#fff',
    borderRadius: 4,
    boxShadow: '2px 2px 0 var(--ink)',
    fontWeight: 800,
    fontSize: 13,
    color: 'var(--ink)',
    cursor: 'pointer',
    position: 'relative',
  },
  tabActive: {
    background: '#eef7e6',
    borderColor: 'var(--leaf-dark)',
    color: 'var(--leaf-dark)',
    boxShadow: '2px 2px 0 var(--leaf-dark)',
  },
  tabActiveUnderline: {
    position: 'absolute',
    left: 10,
    right: 10,
    bottom: 4,
    height: 3,
    background: 'var(--leaf-dark)',
    borderRadius: 2,
  },
  chipRow: {
    display: 'flex',
    gap: 8,
    flexWrap: 'wrap',
  },
  chip: {
    display: 'inline-flex',
    alignItems: 'center',
    gap: 6,
    padding: '5px 10px',
    background: '#fff',
    border: '2px solid var(--ink)',
    borderRadius: 4,
    boxShadow: '2px 2px 0 var(--ink)',
    fontSize: 12,
    fontWeight: 700,
    color: 'var(--ink)',
    minHeight: 32,
  },
  chipDot: {
    width: 10,
    height: 10,
    borderRadius: '50%',
    border: '2px solid var(--ink)',
    flexShrink: 0,
  },
  chipLabel: {
    color: '#6b6250',
    fontSize: 10,
    textTransform: 'uppercase',
    letterSpacing: 0.6,
    fontWeight: 800,
  },
  chipValue: {
    fontSize: 13,
  },
  dots: {
    display: 'flex',
    gap: 6,
    alignItems: 'center',
  },
  dot: {
    width: 9,
    height: 9,
    borderRadius: '50%',
    border: '2px solid var(--ink)',
    background: '#fff',
  },
  dotOn: {
    background: 'var(--leaf)',
  },
};
