{
  "name": "lifeseedlab",
  "private": true,
  "version": "0.0.68",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:show": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "lint:hooks": "eslint src --rule 'react-hooks/rules-of-hooks:error'"
  },
  "dependencies": {
    "browser-use-sdk": "^3.11.3",
    "dotenv": "^18.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {}
}
