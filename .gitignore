# Werkzeug-Ordner: nur die Gate-Skripte sind getrackt (der Gate-Verweis in shinon.config.json
# darf nicht ins Leere zeigen — Befund: check-changelog.sh fehlte im Repo).
/scripts/*
!/scripts/check-changelog.sh
!/scripts/test-lane.mjs
# Register-Generator: von CI ("Register gegen Contracts prüfen") und Register-Regel 7 gerufen —
# ein Verweis auf ein nicht getracktes Skript wäre für jeden frischen Klon tot.
!/scripts/quality-register.mjs
# Testzahl-Wächter: von CI ("Testzahl messen") gerufen und von docs/quality/contracts/process.md
# referenziert — dieselbe Begründung wie oben: ein Verweis auf ein ignoriertes Skript ist für
# jeden frischen Klon tot (Befund 20.09.2026, der Doku-Referenz-Check hat es gefunden).
!/scripts/test-count.mjs
!/scripts/test-lane-verdict.mjs
!/scripts/e2e-lane-map.mjs
# Shinon-Werkzeug: der Code liegt getrackt unter tools/, Laufzeit-Artefakte bleiben lokal.
tools/.tmp/
tools/.shinon-state.json
# Gate-Lock des Werkzeugs (Enforcement-Stufe) — lokaler Zustand, kein Projektinhalt.
# Nicht verwechseln mit shinon.config.json, das die Regeln enthält und getrackt IST.
shinon.lock
commit_msg.txt
CLAUDE.md

# PROPSA-History (lokal, nie committen)
.propsa/

# Lokale Scratch-Ausgaben (Seiten-Dump, Test-Log) — Werkzeugspuren, kein Inhalt
page.html
test-out.txt


# Vitest coverage report (B32 Phase 1)
coverage/

# Lokale Arbeitsplane (Plan-Skill-Ausgaben, kein Repo-Inhalt)
plan/
